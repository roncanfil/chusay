# /opt/chusay/.env on the server. install.sh writes this for you; keep it private (chmod 600).

# Caddy: your domain (an A record pointing at this server) and the shared login
DOMAIN=trips.example.com
BASIC_AUTH_USER=us
# from: docker run --rm caddy:2 caddy hash-password --plaintext 'your password'
# keep the single quotes: the hash contains $ signs
BASIC_AUTH_HASH='$2a$14$replace-me'

# The image GitHub builds on every push to main (change it if you run your own fork)
CHUSAY_IMAGE=ghcr.io/roncanfil/chusay:latest

# Real use: starts empty, no "Reset sample data"
DEMO_MODE=false

# Google (optional). Without them the app uses the preview's sketch maps and sample search.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_PLACES_SERVER_KEY=
