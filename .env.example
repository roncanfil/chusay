# Copy to .env and fill in. Never commit .env.

# Where the SQLite file lives (inside the container it's on the /data volume)
DATABASE_PATH=./data/chusay.db

# true: a new database starts with sample trips and the header offers "Reset sample data".
# Leave it off for real use.
DEMO_MODE=true

# Google. Leave empty to keep the preview's sketch maps and sample search.
# The key the browser sees: enable "Maps JavaScript API" and restrict it to your domain (HTTP referrers).
GOOGLE_MAPS_BROWSER_KEY=
# Optional: a Map ID from Google Cloud (Map Management) for custom styling. DEMO_MAP_ID works meanwhile.
GOOGLE_MAPS_MAP_ID=
# Used only by API routes: enable "Places API (New)" and restrict it to the server's IP.
GOOGLE_PLACES_SERVER_KEY=

# Not used yet; comes in with the culture and suggestion steps of the build guide.
ANTHROPIC_API_KEY=
